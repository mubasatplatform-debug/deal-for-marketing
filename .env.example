# Copy into your host's project settings (never commit a real .env).

# Postgres (Neon / Vercel Postgres). Required in production: without it the
# deploy refuses to start rather than lose data in an in-memory database.
DATABASE_URL=

# Better Auth session signing secret and public URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# New-lead notification: any webhook that accepts JSON (Slack, Discord,
# Zapier/Make -> WhatsApp/email, or your CRM). Optional bearer secret.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Comma-separated Google account emails allowed into /admin.
ADMIN_EMAILS=

# Deal Line AI, first match wins:
#   ANTHROPIC_API_KEY  -> Claude on the Anthropic API
#   AI_GATEWAY_API_KEY -> Claude through Vercel AI Gateway
#   XAI_API_KEY        -> xAI
#   (none, on your own Vercel deploy) -> Claude through AI Gateway using the
#   deployment's OIDC token: no key needed, billed to the team's AI credits
#   otherwise the local router answers.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
XAI_API_KEY=
# Max paid model calls per 24h across all visitors (default 1500).
LINE_DAILY_CAP=
