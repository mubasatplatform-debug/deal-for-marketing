# Copy into your host's project settings (never commit a real .env).

# "1" on a standalone Node host (Render, a VPS) — set it for the build AND at
# runtime. Builds the nitro node-server preset (.output/server, run by
# `npm start`; `npm run build:standalone` sets it for you) instead of the
# Vercel/Grok preset, skips the Grok platform middleware, and makes startup
# fail fast when DATABASE_URL is missing. Leave unset on Grok / Vercel.
# See render.yaml.
DEAL_STANDALONE=

# Postgres (Neon / Vercel Postgres / Render Postgres). Required in production:
# without it the deploy refuses to start rather than lose data in an in-memory
# database.
DATABASE_URL=

# Better Auth session signing secret and public URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Other public origins allowed to sign in when BETTER_AUTH_URL is set,
# comma-separated (e.g. the host's own https://deal-for-marketing.onrender.com).
AUTH_TRUSTED_ORIGINS=
# "password" on deploys outside the Grok platform (e.g. your own Vercel
# project): email + password sign-in instead of the Grok Google / X broker,
# which only accepts Grok-hosted callbacks. Leave unset on Grok.
VITE_SIGNIN_MODE=

# New-lead notification: any webhook that accepts JSON (Slack, Discord,
# Zapier/Make -> WhatsApp/email, or your CRM). Optional bearer secret.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# Transactional mail relay, bearer MAIL_RELAY_TOKEN. Actions: 'reset'
# (password reset) and 'message' (new message on a request thread:
# { action, to: 'team' | customer email, name, requestId, service, preview, url }).
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=

# Request-thread attachments: set to a Vercel Blob read-write token to keep
# file bytes in a PRIVATE Blob store (downloads still go through the app's
# authorized /api/files route). Unset: bytes are stored in Postgres (bytea).
BLOB_READ_WRITE_TOKEN=

# Comma-separated emails allowed into /admin (Google sign-in, or an
# email/password account in VITE_SIGNIN_MODE=password).
ADMIN_EMAILS=

# Deal Line AI, first match wins:
#   ANTHROPIC_API_KEY  -> Claude on the Anthropic API
#   AI_GATEWAY_API_KEY -> Claude through Vercel AI Gateway
#   XAI_API_KEY        -> xAI
#   LLM_BASE_URL + LLM_API_KEY (+ LLM_MODEL) -> any OpenAI-compatible
#                         endpoint, e.g. a relay in front of another provider
#   (none, on your own Vercel deploy) -> Claude through AI Gateway using the
#   deployment's OIDC token: no key needed, billed to the team's AI credits
#   otherwise the local router answers.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Max paid model calls per 24h across all visitors (default 1500).
LINE_DAILY_CAP=

# «مكتب المحامي» subscriptions. Bank details shown for manual (bank-transfer)
# payments; unset -> the page says the DEAL team will send them.
LAW_BANK_NAME=
LAW_BANK_BENEFICIARY=
LAW_BANK_IBAN=
# Moyasar (card / mada / Apple Pay) — UNTESTED; card checkout stays off until
# MOYASAR_SECRET_KEY is set. Webhook: POST /api/law/moyasar, shared secret below.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# «مكتب المحامي» video consultations — LiveKit (optional, recommended).
# All three set: calls run EMBEDDED in /meet/<token> and /app/consultations/<id>/call
# with a waiting room (tokens are minted server-side; the secret never reaches
# the browser). Any missing: falls back to Jitsi Meet (meet.jit.si, new tab);
# a lawyer can also paste a Zoom / Google Meet / Teams link per consultation.
# LIVEKIT_URL is the wss:// project URL, e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Secret the client meeting links (/meet/<token>) are derived with (only their
# SHA-256 is stored). Optional: falls back to BETTER_AUTH_SECRET. Changing it
# invalidates every link sent so far (they can be re-issued per consultation).
LAW_MEET_SECRET=
# The mail relay (MAIL_RELAY_URL) also gets action 'consult' — see
# sendConsultEmail in src/lib/mail.server.ts for the body.
